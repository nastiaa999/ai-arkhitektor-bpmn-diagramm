# --- какая модель используется (имя профиля из app/models.yaml) ---
LLM_PROFILE=gigachat

# --- GigaChat (бесплатный тариф для физлиц) ---
# Ключ авторизации из https://developers.sber.ru/studio -> проект GigaChat API -> "Ключ авторизации"
GIGACHAT_CREDENTIALS= 
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Сертификат НУЦ Минцифры (см. README), путь к .crt/.pem:
GIGACHAT_CA_BUNDLE=
# Только для локальной отладки, если сертификат не настроен: false
GIGACHAT_VERIFY_SSL=false

# --- любой OpenAI-совместимый API (vLLM, OpenRouter, Yandex AI Studio ...) ---
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
